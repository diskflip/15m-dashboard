# Copy this file to .env (in the project root, next to package.json) and fill in.

# From your Kalshi account -> API Keys.
KALSHI_API_KEY_ID=

# Path to the RSA private key file downloaded when you created the API key.
KALSHI_PRIVATE_KEY_PATH=./server/kalshi-private-key.pem

# Usually fine to leave at the defaults below.
# KALSHI_REST_BASE_URL=https://api.elections.kalshi.com
# KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
# BTC_SERIES_TICKER=KXBTCD
# MARKET_POLL_INTERVAL_MS=15000
# LOCAL_WS_PORT=4001
